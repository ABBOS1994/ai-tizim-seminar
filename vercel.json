{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "ai-tizim-seminar.vercel.app" }],
      "destination": "https://seminar.vox-digital.uz/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ai-tizim-seminar.vercel.app" }],
      "destination": "https://seminar.vox-digital.uz/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "seminar2.vox-digital.uz" }],
      "destination": "/v2/:path*"
    }
  ]
}
